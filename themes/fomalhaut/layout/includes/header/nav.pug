      //-   svg.faa-tada(style="height:25px;width:25px;fill:currentColor;position:relative;top:7px", viewBox='0 0 1024 1024')
      //-     use#modeicon(xlink:href='#icon-moon')

      #toggle-menu
        a
          i.fas.fa-bars.fa-fw


