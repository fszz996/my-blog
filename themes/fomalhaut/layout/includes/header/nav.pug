nav#nav
  span#blog_name
    //- 左上角头像（2026-11-23，站点级开关见 _config.fomalhaut.yml → nav_avatar）
    //- 头像直接取 theme.avatar.img，和侧栏、关于页共用同一张图，换头像只改一处
    if theme.nav_avatar && theme.nav_avatar.enable
      if !theme.nav_avatar.home_only || is_home()
        a#nav-avatar(href=url_for('/') title='回到首页' aria-label='回到首页')
          //- no-lazyload：首屏元素，交给主题的懒加载过滤器原样保留 src（见 scripts/filters/post_lazyload.js）
          img.no-lazyload(src=url_for(theme.avatar.img) alt=config.author)
    a#site-name(href=url_for('/')) #[=config.title]
    
  #menus
    !=partial('includes/header/menu_item', {}, {cache: true})
    //- 这两行是导航栏显示标题用的
    center(id="name-container")
      a(id="page-name" href="javascript:scrollToTop()") PAGE_NAME
      
    #nav-right
      if (theme.algolia_search.enable || theme.local_search.enable)
        #search-button
          //- 2026-11-23：换成极简线性放大镜（原来是 iconfont 的实心图标）
          a.search.faa-parent.animated-hover(title="检索站内任何你想要的信息")
            svg.search-ico(aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round")
              circle(cx="11" cy="11" r="6.5")
              line(x1="16" y1="16" x2="21" y2="21")
            span=' '+_p('search.title')

      //- 2026-11-23 移除：美化设置（#meihua-button）与暗黑模式（#nightmode-button）两个按钮。
      //- 页面仍会按 daynight-boot.js 的规则自动日夜切换，只是不再提供手动入口。
      //- 想恢复：把下面这段注释解开即可。
