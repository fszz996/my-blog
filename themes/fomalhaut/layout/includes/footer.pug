    .ft-item-2
      p.ft-t 推荐友链⌛
      //- 展示位：本站头像 + 几个上游项目，图片都是本地生成的占位图（source/assets/friends/），
      //- 换成朋友的头像时直接替换同名文件即可（建议 100x100 以内）。
      .ft-img-group
        .img-group-item
          a(href='/' title='本站')
            img(src='/assets/avatar.jpg' alt='')
        .img-group-item
          a(href='https://hexo.io/zh-cn/' title='Hexo')
            img(src='/assets/friends/hexo.png' alt='')
        .img-group-item
          a(href='https://butterfly.js.org/' title='Butterfly')
            img(src='/assets/friends/butterfly.png' alt='')
        .img-group-item
          a(href='https://busuanzi.ibruce.info/' title='不蒜子')
            img(src='/assets/friends/frontier.png' alt='')
        .img-group-item
          a(href='/social/link/' title='想出现在这儿？来交换友链')
            img(src='/assets/friends/slot.png' alt='')

  if theme.footer.owner.enable
    - var now = new Date()
    - var nowYear = now.getFullYear()
    //- if theme.footer.owner.since && theme.footer.owner.since != nowYear
    //-   .copyright!= `&copy;${theme.footer.owner.since} - ${nowYear} By ${config.author}`
    //- else
    //-   .copyright!= `&copy;${nowYear} By ${config.author}`
    //- 新加的
    if theme.footer.owner.since && theme.footer.owner.since != nowYear
      .copyright
        span!= `<b>&copy;${theme.footer.owner.since}-${nowYear}</b>`
        span!= `<b>&nbsp;&nbsp;By ${config.author}</b>`
    else
       .copyright
         span!= `<b>&copy;${nowYear}</b>`
         span!= `<b>&nbsp;&nbsp;By ${config.author}</b>`
    //- 到这里
  if theme.footer.copyright
    .framework-info
      span= _p('footer.framework') + ' '
      a(href='https://hexo.io')= 'Hexo'
      span.footer-separator |
      span= _p('footer.theme') + ' '
      a(href='https://github.com/jerryc127/hexo-theme-butterfly')= 'Butterfly'
  if theme.footer.custom_text
    .footer_custom_text!=`${theme.footer.custom_text}`
  #workboard
